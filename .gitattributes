# The published dist/ must contain LF. leaflet-distortable-video@1.0.0 shipped
# with 286 CRLF lines in dist/index.js that are not in the committed file,
# because the tarball was built from a checkout that rewrote line endings.
# Normalising here means a checkout on any platform commits LF regardless.
* text=auto eol=lf

# Vendored third-party builds are kept byte-identical to what upstream ships,
# so they stay verifiable against the CDN they came from. leaflet.css and
# leaflet-rotate-map.css genuinely contain CRLF upstream; leave them alone.
examples/vendor/** -text

# Binary assets: never touch, and do not try to diff.
*.mp4 binary
*.jpg binary
*.png binary
